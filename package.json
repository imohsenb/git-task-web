{
  "name": "git-task-web",
  "version": "0.1.3",
  "description": "Local web interface for the git-task CLI",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imohsenb/git-task-web.git"
  },
  "author": "Mohsen Beiranvand",
  "bin": {
    "git-task-web": "dist/server/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server/main.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:web": "vite build",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "async-mutex": "^0.5.0",
    "execa": "^9.5.2",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "open": "^10.1.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
